{
  "name": "residencycheck",
  "version": "0.1.0",
  "description": "Know where your payment data lives before CBN asks. Scans a project for payment data stored or sent outside Nigeria.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "residencycheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "cbn",
    "nigeria",
    "data-localisation",
    "data-residency",
    "compliance",
    "fintech",
    "payments"
  ],
  "dependencies": {
    "ignore": "^6.0.2",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
